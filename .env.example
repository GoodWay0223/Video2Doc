# Copy these names into your preferred secret manager or user environment.
# Never commit real values.
DOUBAO_API_KEY=
SILICONFLOW_API_KEY=

# Optional local Whisper model. Default: turbo. Use tiny/base only for faster smoke tests.
VIDEO2DOC_WHISPER_MODEL=

# Optional explicit login sources. Video2Doc never reads live Chrome implicitly.
VIDEO2DOC_BILIBILI_COOKIES_FILE=
VIDEO2DOC_DOUYIN_COOKIES_FILE=
VIDEO2DOC_DOUYIN_STORAGE_STATE=

# Optional: improves Xiaohongshu download success. Treat cookies as credentials.
XHS_COOKIE=
